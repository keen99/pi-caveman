{
  "name": "pi-caveman",
  "version": "1.0.0",
  "description": "pi extension: compressed caveman communication style with persistence (lite/full/ultra)",
  "keywords": [
    "pi-package",
    "pi-extension",
    "caveman",
    "compression",
    "tokens"
  ],
  "license": "MIT",
  "author": "David Raistrick",
  "homepage": "https://github.com/keen99/pi-caveman",
  "repository": {
    "type": "git",
    "url": "https://github.com/keen99/pi-caveman.git"
  },
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "npm test",
    "test:matrix": "node test/release-matrix.mjs"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
